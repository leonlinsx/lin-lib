---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { slugifyTag } from '../../utils/tags';

const posts = await getCollection('blog');

// Collect all tags with counts by canonical slug while preserving display labels.
const tagCounts = new Map<string, { count: number; label: string }>();
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    const slug = slugifyTag(tag);
    if (!slug) continue;
    const current = tagCounts.get(slug);
    if (current) {
      current.count += 1;
    } else {
      tagCounts.set(slug, { count: 1, label: tag });
    }
  }
}

// Convert to sorted array
const tags = Array.from(tagCounts.entries()).sort((a, b) =>
  a[1].label.localeCompare(b[1].label),
);
---

<BaseLayout
  title={`Tags | ${SITE_TITLE}`}
  description="Browse all tags used in the blog."
>
  <h1>All Tags</h1>
  <ul class="tag-list">
    {
      tags.map(([slug, info]) => (
        <li>
          <a href={`/tags/${slug}/`}>
            {info.label} ({info.count})
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
  }
  .tag-list li a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-base-sm);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .tag-list li a:hover {
    background: var(--color-border);
    border-color: var(--color-link);
    color: var(--color-link);
  }
</style>
